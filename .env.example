# ─────────────────────────────────────────────────────────────────────────────
# TraderPro Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production          # development | production
PORT=3000

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED — server will refuse to start without this
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# REQUIRED in production — server will refuse to start without this when NODE_ENV=production
# Comma-separated list of allowed CORS origins
# Example: https://traderpro.app,https://www.traderpro.app
ALLOWED_ORIGINS=

# ── Optional: API Keys (set via /settings in the app, or here as defaults) ───
OPENROUTER_API_KEY=
FRED_API_KEY=

# ── Email / Password Reset ────────────────────────────────────────────────────
# Recommended: Resend (resend.com) — free tier: 3,000 emails/month, no credit card.
# 1. Sign up at resend.com, verify your domain, get an API key
# 2. Fill in the settings below — SMTP_PASS is your Resend API key (starts with re_)
#
# Without SMTP_HOST: dev mode logs reset links to the console (never use in production)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_REPLACE_WITH_YOUR_RESEND_API_KEY
SMTP_FROM=TraderPro <noreply@yourdomain.com>
# Public URL used to build reset links — REQUIRED when SMTP is configured
APP_URL=https://yourdomain.com

# ── Stripe (billing) ─────────────────────────────────────────────────────────
# 1. Create a Stripe account at stripe.com
# 2. Create a Product + monthly Price in the Stripe dashboard (or with the CLI)
# 3. Set up a webhook endpoint pointing to https://yourdomain.com/api/billing/webhook
#    and listen for: checkout.session.completed, customer.subscription.updated,
#    customer.subscription.deleted
#
# Test keys start with sk_test_ / pk_test_ — use these in development
# Live keys start with sk_live_ / pk_live_ — use only in production
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_STRIPE_SECRET_KEY
STRIPE_PRICE_ID_MONTHLY=price_REPLACE_WITH_MONTHLY_19
STRIPE_PRICE_ID_ANNUAL=price_REPLACE_WITH_ANNUAL_149
STRIPE_PRICE_ID_LIFETIME=price_REPLACE_WITH_LIFETIME_199
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET

# ── Optional: Custom DB path (defaults to ./trader_portal.db) ────────────────
DB_PATH=

# ── Optional: ML service URL (defaults to http://127.0.0.1:5001) ─────────────
ML_SERVICE_URL=http://127.0.0.1:5001

# ── Optional: AutoTrade service URL (defaults to http://127.0.0.1:5002) ──────
AUTOTRADE_SERVICE_URL=http://127.0.0.1:5002

# ── Telegram Notifications ────────────────────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy the token below
# 2. Add your bot to a channel/group and make it an admin with "Post Messages" permission
# 3. Get the chat ID (use @userinfobot or check the channel URL)
# These can also be configured via the Admin → Notifications panel at runtime
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
